<h1 class="text-3xl font-extrabold mb-6">Corbeille</h1>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% (mineDeleted || []).forEach(r => { %>
    <div class="bg-white rounded-2xl overflow-hidden border shadow-sm card">
      <% if (r.image_path) { %>
        <img src="<%= r.image_path %>" class="w-full h-40 object-cover" alt="<%= r.title %>" />
      <% } %>
      <div class="p-4">
        <h3 class="font-semibold"><%= r.title %></h3>
        <p class="text-sm muted">Supprimée le <%= new Date(r.deleted_at).toLocaleString() %></p>
        <div class="mt-3 flex gap-2">
          <form method="post" action="/trash/<%= r.id %>/restore">
            <button class="px-3 py-2 rounded-lg bg-slate-900 text-white">Restaurer</button>
          </form>
          <form method="post" action="/trash/<%= r.id %>/purge" onsubmit="return confirm('Supprimer définitivement ?')">
            <button class="px-3 py-2 rounded-lg bg-red-600 text-white">Supprimer</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!mineDeleted || !mineDeleted.length) { %><p class="muted">Corbeille vide.</p><% } %>
</div>
