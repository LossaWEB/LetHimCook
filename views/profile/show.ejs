<section class="mb-6">
  <h1 class="text-3xl font-extrabold">Profil</h1>
  <p class="muted">Connecté en tant que <strong><%= user.display_name %></strong> (<%= user.email %>)</p>
</section>

<% if (badges && badges.length){ %>
  <div class="mb-6 flex flex-wrap gap-2">
    <% badges.forEach(b => { %>
      <span class="px-3 py-1 rounded-full border bg-white card text-sm">🧩 <%= b %></span>
    <% }) %>
  </div>
<% } %>

<h2 class="text-xl font-bold mb-3">Vos recettes</h2>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
  <% (mine || []).forEach(r => { %>
    <a href="/recipes/<%= r.id %>" class="group bg-white rounded-2xl overflow-hidden border shadow-sm hover:shadow-md transition card">
      <% if (r.image_path) { %>
        <img src="<%= r.image_path %>" class="w-full h-40 object-cover" alt="<%= r.title %>" />
      <% } %>
      <div class="p-4">
        <h3 class="font-semibold group-hover:underline"><%= r.title %></h3>
        <p class="text-sm muted"><%= r.category %> · <%= r.difficulty %> · <%= r.duration_minutes %> min</p>
      </div>
    </a>
  <% }) %>
  <% if (!mine || !mine.length) { %><p class="muted">Vous n’avez pas encore de recette.</p><% } %>
</div>

<h2 class="text-xl font-bold mb-3">Vos favoris</h2>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
  <% (favs || []).forEach(r => { %>
    <a href="/recipes/<%= r.id %>" class="group bg-white rounded-2xl overflow-hidden border shadow-sm hover:shadow-md transition card">
      <% if (r.image_path) { %>
        <img src="<%= r.image_path %>" class="w-full h-40 object-cover" alt="<%= r.title %>" />
      <% } %>
      <div class="p-4">
        <h3 class="font-semibold group-hover:underline"><%= r.title %></h3>
        <p class="text-sm muted"><%= r.category %> · <%= r.difficulty %> · <%= r.duration_minutes %> min</p>
      </div>
    </a>
  <% }) %>
  <% if (!favs || !favs.length) { %><p class="muted">Aucun favori pour le moment.</p><% } %>
</div>
