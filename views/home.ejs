<section class="rounded-2xl p-10 bg-gradient-to-br from-indigo-50 to-slate-100 border mb-6 card">
  <h1 class="text-4xl font-extrabold mb-2">Bienvenue sur LetHimCook</h1>
  <p class="muted">Créez, notez, commentez et gardez vos favoris.</p>
</section>

<div class="mb-6 flex flex-wrap gap-2">
  <a href="/?h=latest" class="px-3 py-2 rounded-lg border <%= h==='latest'?'bg-slate-900 text-white':'bg-white plain' %>">Dernières</a>
  <a href="/?h=fast"   class="px-3 py-2 rounded-lg border <%= h==='fast'  ?'bg-slate-900 text-white':'bg-white plain' %>">Rapides</a>
  <a href="/?h=easy"   class="px-3 py-2 rounded-lg border <%= h==='easy'  ?'bg-slate-900 text-white':'bg-white plain' %>">Faciles</a>
</div>

<section>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% (latest || []).forEach(r => { %>
      <a href="/recipes/<%= r.id %>" class="group bg-white rounded-2xl overflow-hidden border shadow-sm hover:shadow-md transition card">
        <% if (r.image_path) { %>
          <img src="<%= r.image_path %>" class="w-full h-40 object-cover" alt="<%= r.title %>" />
        <% } %>
        <div class="p-4">
          <h3 class="font-semibold group-hover:underline"><%= r.title %></h3>
          <p class="text-sm muted"><%= r.category %> · <%= r.difficulty %> · <%= r.duration_minutes %> min</p>
        </div>
      </a>
    <% }) %>
  </div>
</section>
